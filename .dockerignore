# Todo lo que no necesita `vite build`. Cuanto menos entra en el contexto,
# menos tarda `docker build` y menos se invalida la caché de capas.

# node_modules se reinstala dentro de la imagen con npm ci: copiar el de la
# máquina local, además de ser lo más pesado del contexto, arrastraría binarios
# compilados para otra libc y rompería el build en Alpine.
node_modules
dist
dist-ssr

.git
.gitignore
.github

# El sitio estático original: se conserva como referencia histórica, pero no
# entra en el bundle (el entry point es index.html + src/).
legacy

Dockerfile
.dockerignore
README.md

# Las variables de entorno de Vite se congelan en el bundle durante el build;
# dejarlas fuera del contexto evita hornear credenciales locales en la imagen.
.env
.env.*
!.env.example

*.log
npm-debug.log*
.vite/
*.local
*.zip

.vscode
.idea
.DS_Store
Thumbs.db
